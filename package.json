{
  "name": "detour",
  "description": "Switch HTTP, HTTPS, or SOCKS proxy profiles from your toolbar, with auto-switch rules, health checks, failover, auth, and bypass.",
  "private": true,
  "license": "MIT",
  "version": "1.7.2",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit && tsc -p e2e && tsc -p scripts",
    "test": "bun test --coverage",
    "test:e2e": "bun run test:e2e:chrome && bun run test:e2e:firefox",
    "test:e2e:chrome": "wxt build && bun test ./e2e/*.e2e.ts --timeout 30000",
    "test:e2e:firefox": "wxt build -b firefox && DETOUR_BROWSER=firefox bun test ./e2e/*.e2e.ts --timeout 30000",
    "browsers": "puppeteer browsers install chrome && puppeteer browsers install firefox",
    "screenshots": "wxt build && bun e2e/screenshots.ts",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test",
    "package": "wxt zip && wxt zip -b firefox && bun scripts/package.ts",
    "package:verify": "bun scripts/verify-sources.ts",
    "submit:firefox": "wxt submit --firefox-zip .output/*-firefox.zip --firefox-sources-zip .output/*-sources.zip",
    "submit:chrome": "wxt submit --chrome-zip .output/*-chrome.zip --chrome-api-version v2 --chrome-cancel-pending",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.5",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@wxt-dev/module-vue": "^1.0.3",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "fflate": "^0.8.3",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "publish-browser-extension": "^6.2.0",
    "puppeteer": "^25.18.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14",
    "wxt": "^0.21.5"
  }
}
