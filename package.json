{
  "name": "detour",
  "description": "Switch HTTP, HTTPS, or SOCKS proxy profiles from your toolbar, with auto-switch rules, health checks, failover, auth, and bypass.",
  "private": true,
  "license": "MIT",
  "version": "1.7.1",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:normalize": "bun scripts/normalize-zips.ts",
    "zip:all": "bun run zip && bun run zip:firefox && bun run zip:normalize",
    "submit:firefox": "wxt submit --firefox-zip .output/*-firefox.zip --firefox-sources-zip .output/*-sources.zip",
    "submit:chrome": "wxt submit --chrome-zip .output/*-chrome.zip --chrome-api-version v2 --chrome-cancel-pending",
    "compile": "vue-tsc --noEmit",
    "test": "bun test",
    "test:e2e": "bun run build && tsc -p e2e && playwright test -c e2e/playwright.config.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "@wxt-dev/module-vue": "^1.0.3",
    "publish-browser-extension": "^6.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13",
    "wxt": "^0.21.4"
  },
  "trustedDependencies": [
    "spawn-sync"
  ],
  "overrides": {
    "publish-browser-extension": "6.1.1"
  }
}
