{
  "name": "detour",
  "description": "Simple proxy switcher — HTTP, HTTPS, SOCKS4/5 with authentication.",
  "private": true,
  "version": "1.4.2",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:normalize": "bun scripts/normalize-zips.ts",
    "zip:all": "bun run zip && bun run zip:firefox && bun run zip:normalize",
    "submit:firefox": "wxt submit --firefox-zip .output/*-firefox.zip --firefox-sources-zip .output/*-sources.zip",
    "submit:chrome": "wxt submit --chrome-zip .output/*-chrome.zip",
    "compile": "vue-tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@wxt-dev/module-vue": "^1.0.3",
    "publish-browser-extension": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vue-tsc": "^3.3.9",
    "wxt": "^0.21.3"
  },
  "trustedDependencies": [
    "spawn-sync"
  ],
  "overrides": {
    "publish-browser-extension": "6.1.1"
  }
}
